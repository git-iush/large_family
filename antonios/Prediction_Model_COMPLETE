   "source": [
    "medicaid_mapping = {1:0, 2:1}\n",
    "df['MEDICAID'] = df['HINSCAID'].map(medicaid_mapping)\n",
    "df['MEDFARE'] = df['MEDICAID'] * df['WELFARE']\n",
    "\n",
    "df['FAMINC'] = df['FTOTINC'] - df['INCTOT']\n",
    "df['PRSNINC'] = df['PRSNINC'] / 10000\n",
    "df['FAMINC'] = df['FAMINC'] / 10000\n",
    "df['PRSNINC2'] = df['PRSNINC'] ** 2\n",
    "df['FAMINC2'] = df['FAMINC'] ** 2\n",
    "\n",
    "df['AGE2'] = df['AGE'] ** 2\n",
    "\n",
    "df['HIGHSCHOOL'] = [1 if i == 63 or i==64 else 0 for i in df['EDUCD']]\n",
    "df['BACHELORS'] = [1 if i == 101 else 0 for i in df['EDUCD']]\n",
    "df['ADVANCED'] = [1 if i>=114 else 0 for i in df['EDUCD']]\n",
    "\n",
    "df['MARD'] = [1 if i==1 or i==2 or i==3 else 0 for i in df['MARST']]\n",
    "\n",
    "df['LARGEFAM'] = [1 if i >= 3 else 0 for i in df['NCHILD']]"
   ]
  },
